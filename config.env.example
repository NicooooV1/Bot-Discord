# config.env — Discord monitoring bot. Copy to /opt/discord-bot/config.env (0600, NEVER in git).
# install.sh creates it from this template if absent and never clobbers it.
# IMPORTANT: systemd EnvironmentFile does NOT support inline comments — keep every comment
# on its own line. A value is everything after '=' to end of line (no trailing '# ...').

# ===== Discord (gateway bot) =====
# DISCORD_TOKEN: bot token from https://discord.com/developers/applications
DISCORD_TOKEN=
# GUILD_ID: your server id (enable Developer Mode to copy ids)
GUILD_ID=
# ADMIN_IDS: csv of Discord user ids allowed to run safe actions
ADMIN_IDS=
# ADMIN_CHANNEL_ID (LEGACY, vide conseillé) : depuis le 2026-08-29 les actions (/ctctl, /backup,
# /audit, /dashboard, /logstream) se lancent depuis la catégorie « 🔒 Lock <srv> » du serveur
# visé (visible des seuls M/O de ce serveur). Un id ici reste accepté EN PLUS, pour le primaire.
ADMIN_CHANNEL_ID=
# READ_CHANNEL_IDS: csv of channels where read commands are allowed (empty = anywhere in guild)
READ_CHANNEL_IDS=
# ALERT_CHANNEL_ID: proactive owned-gap alerts (RAID/SMART/IPMI/backup/thinpool)
ALERT_CHANNEL_ID=
# REPORT_CHANNEL_ID: daily report
REPORT_CHANNEL_ID=
# LIVE_LOG_CHANNEL_ID: live syslog stream (empty = UDP listener disabled)
LIVE_LOG_CHANNEL_ID=
# CT_CHANNELS: per-CT live channels "ctname:channelid,ctname:channelid,..."
# (ctname = the real Proxmox CT name; the bot keeps a live pinned message per channel)
CT_CHANNELS=

# ===== InfluxDB v2 (read-only token) =====
INFLUX_URL=http://10.3.10.120:8086
INFLUX_ORG=Home
INFLUX_BUCKET=Proxmox
# INFLUX_TOKEN: create a READ token on bucket Proxmox in the InfluxDB UI
INFLUX_TOKEN=

# ===== Proxmox API (two least-privilege tokens; secrets from pve_setup_token.sh) =====
PVE_HOST=10.3.10.200
PVE_PORT=8006
PVE_NODE=pve
# PVE_VERIFY_SSL: false = trust self-signed 8006 cert on the trusted mgmt LAN
PVE_VERIFY_SSL=false
PVE_TOKEN_ID=discordbot@pve!bot
PVE_TOKEN_SECRET=
PVE_ACTION_TOKEN_ID=discordbot@pve!actions
PVE_ACTION_TOKEN_SECRET=
# PVE_PBS_STORAGE: PVE storage id of the PBS datastore (target for /backup)
PVE_PBS_STORAGE=pbs

# ===== Live log stream =====
LIVE_LOG_BIND_ADDR=0.0.0.0
LIVE_LOG_BIND_PORT=514
# LIVE_LOG_MIN_SEVERITY: emerg<alert<crit<err<warning<notice<info<debug ; <= is forwarded
LIVE_LOG_MIN_SEVERITY=warning
LIVE_LOG_FLUSH_INTERVAL=10
LIVE_LOG_MAX_GROUPS_PER_FLUSH=8
# LOG_RETRY_QUEUE_MAX: messages Discord en echec gardes en file, re-tentes au flush suivant
LOG_RETRY_QUEUE_MAX=20
# LOG_REPEAT_COOLDOWN_SECONDS: anti-repetition entre fenetres de flush (0 = desactive)
LOG_REPEAT_COOLDOWN_SECONDS=300
# LOG_STARTUP_NOTICE: poste une ligne "flux demarre" dans le salon de logs au demarrage
LOG_STARTUP_NOTICE=true
# LOG_IGNORE_REGEX: motifs re.search separes par ';' appliques a "host app: texte" (drop si match)
LOG_IGNORE_REGEX=
# LOG_MIN_SEV_OVERRIDES: seuil par hote "host:sev,host:sev" (remplace le seuil global ;
# en pratique ne peut que durcir : les emetteurs rsyslog ne forwardent que *.warning)
LOG_MIN_SEV_OVERRIDES=
# LOG_MUTE_PROGRAMS: appnames ignores, csv, insensible a la casse (ex: systemd,CRON)
LOG_MUTE_PROGRAMS=
# LOG_ROUTE_PER_CT: route les groupes vers les salons CT_CHANNELS (false = tout dans le salon de logs)
LOG_ROUTE_PER_CT=false
# LOG_ROUTE_MODE: mirror = salon de logs + salon du CT ; move = salon du CT uniquement
LOG_ROUTE_MODE=mirror

# ===== Loki (logs centralises, optionnel) =====
# LOKI_URL: endpoint Loki, ex http://10.3.10.123:3100 (vide = /logsearch /ctlogs /apperrors desactives)
LOKI_URL=

# ===== Salon « 🔒 Lock » + console root de l'HYPERVISEUR (SSH) =====
# Pourquoi SSH et pas termproxy comme la console LXC : PVE ne donne un shell root sur le
# NŒUD qu'à root@pam (PVE/API2/Nodes.pm, get_shell_command) ; tout autre compte, même avec
# Sys.Console, tombe sur un prompt « login: ». Passer par termproxy aurait donc imposé de
# stocker le mot de passe root de PVE en clair ici. Détail complet : bot/core/nodeshell.py.
#
# Prérequis côté hôte (une fois) :
#   ssh-keygen -t ed25519 -N '' -f ./node_ed25519
#   # clé publique -> /etc/pve/priv/authorized_keys de l'hôte, PRÉFIXÉE des restrictions :
#   #   restrict,pty,from="<IP du LXC du bot>" ssh-ed25519 AAAA... discord-node-shell
#   # clé privée -> NODE_SSH_KEY dans le LXC (chown discordbot, chmod 400)
#   # host key   -> NODE_SSH_KNOWN_HOSTS :  <IP hôte> ssh-ed25519 <contenu de
#   #                /etc/ssh/ssh_host_ed25519_key.pub>
#   # + autoriser l'egress du LXC vers l'hôte:22 si son pare-feu a policy_out: DROP
# Révocation immédiate : supprimer la ligne d'authorized_keys (ou NODE_TERMINAL_ENABLED=false).
NODE_CHANNEL_ENABLED=true
NODE_TERMINAL_ENABLED=false
# ⚠️ PROPRIÉTAIRE UNIQUEMENT : liste d'user-ids Discord, SANS repli sur les rôles (à la
# différence de TERMINAL_OWNER_ROLE_IDS). Vide -> repli sur ADMIN_IDS.
# Rappel : un membre « Administrateur » de Discord VOIT le salon (les overwrites ne
# s'appliquent pas aux admins) — c'est cette liste, et elle seule, qui protège le shell.
NODE_TERMINAL_OWNER_IDS=
NODE_SSH_HOST=10.3.10.200
NODE_SSH_PORT=22
NODE_SSH_USER=root
NODE_SSH_KEY=/etc/discord-bot/node_ed25519
NODE_SSH_KNOWN_HOSTS=/etc/discord-bot/node_known_hosts
# Inactivité PROPOSÉE par défaut pour la console du nœud (0 = illimitée)
NODE_TERMINAL_IDLE_MIN=10
# Plafond de l'inactivité SAISIE à l'ouverture (modale) ; 0 = AUCUN plafond, donc
# « illimité » saisissable — mais NODE_TERMINAL_MAX_MIN continue alors de borner la
# session si elle n'est pas nulle elle-même (pas de promesse intenable)
NODE_TERMINAL_IDLE_MAX_MIN=60
# bouton 💾 du salon du nœud = vzdump de TOUS les invités (nécessite Datastore.AllocateSpace
# sur /storage/<PVE_PBS_STORAGE> pour le token d'action, en plus de VM.Backup sur /vms)
NODE_BACKUP_ENABLED=true

# ===== Behavior =====
DASHBOARD_INTERVAL_MIN=2
REPORT_HOUR=8
REPORT_MINUTE=0
ALERT_POLL_SECONDS=60
TZ=Europe/Paris
MPLBACKEND=Agg
MPLCONFIGDIR=/opt/discord-bot/.mplcache

# =============================================================================
# BLOCS AJOUTÉS LE 2026-08-11 (audit) — 51 variables étaient lues par
# bot/core/config.py sans figurer ici. Les 19 variables AVY_* n'étaient MENTIONNÉES
# NULLE PART : tout le cluster Aveyron était invisible d'un redéploiement depuis ce
# modèle, ce qui est la cause de fond de plusieurs constats (catégories créées
# publiques faute de clé GESTION_SERVERS, boutons gardés par les mauvais rôles).
# Rappel : systemd EnvironmentFile n'accepte PAS de commentaire en fin de ligne.
# =============================================================================

# ===== Modèle de rôles (3 tiers PAR SERVEUR) =====
# GESTION_SERVERS : « CLÉ:G:M:O[,CLÉ2:G:M:O] » — trois ids de rôles Discord par serveur.
#   G = voir les salons du serveur (aucun bouton)
#   M = agir (boutons + catégorie Lock)
#   O = owner (aucune restriction hors 2FA + délégation via /gestion)
# ⚠️ FAIL-CLOSED depuis le 2026-08-11 : une clé serveur ABSENTE d'ici fait REFUSER
# l'action au lieu de retomber sur ADMIN_ROLE_IDS. Toute clé AVY-<NŒUD> utilisée par
# le bot doit donc figurer ici, sinon les M/O de ce nœud perdent leurs boutons
# (le propriétaire du guild et ADMIN_IDS restent toujours admins : pas de lockout).
GESTION_SERVERS=
# ADMIN_ROLE_IDS : LEGACY — n'est plus consulté que si GESTION_SERVERS est VIDE (instance
# d'avant le modèle G/M/O). Avec GESTION_SERVERS, les admins d'un serveur sont ses rôles M/O,
# et rien d'autre : un rôle listé ici n'ouvre RIEN (audit 2026-08-29 : l'union des M/O de
# plusieurs serveurs ici rendait chacun admin de tous les autres).
ADMIN_ROLE_IDS=
# READ_ROLE_IDS : csv de rôles autorisés aux commandes de LECTURE.
# Vide = seuls les admins lisent (fail-closed volontaire).
READ_ROLE_IDS=
# VIEWER_ROLE_IDS : rôles « visionneurs » MANUELS (ex. « A »). provision leur donne la
# VUE des salons de gestion, mais le bot ne gère JAMAIS leur attribution.
VIEWER_ROLE_IDS=
# SERVER_KEY : clé de CE serveur physique ; les catégories en dérivent
# (📊 Supervision <SRV> / Gestion <SRV> / 🔒 Lock <SRV>).
SERVER_KEY=R820
# IS_PRIMARY : true = cette instance gère les ressources PARTAGÉES (#logs-2fa, #général,
# /gestion, /2fa, rôle « 2FA Complet »). Une instance secondaire ne gère QUE son serveur.
IS_PRIMARY=true
# NODE_SERVER_KEY : serveur dont dépend le salon du NŒUD (catégorie Lock).
# À défaut, le bot retombe sur SERVER_KEY (et NON plus sur la première entrée de
# GESTION_SERVERS : réordonner cette variable ne change donc plus qui détient le shell
# root — corrigé le 2026-08-11). Si la clé retenue est absente de GESTION_SERVERS, la
# catégorie 🔒 Lock, les boutons du salon-hyperviseur et la console du nœud ne sont
# accessibles qu'au propriétaire du guild et à ADMIN_IDS ; une erreur est journalisée
# au démarrage.
NODE_SERVER_KEY=R820
# GENERAL_CHANNEL_ID : salon « général » (vue + écriture pour le rôle A, sans commandes)
GENERAL_CHANNEL_ID=
# AUTO_PROVISION : création/réconciliation automatique des salons et catégories
AUTO_PROVISION=true
PROVISION_RECONCILE_MIN=5

# ===== 2FA (TOTP) =====
# TWOFA_ENABLED : false par défaut — activer APRÈS un premier /2fa setup, sinon le bot
# barre toutes les commandes sans laisser personne s'inscrire.
# BREAK-GLASS : remettre false ici + systemctl restart discord-bot.
TWOFA_ENABLED=false
# Durée par défaut d'une session de confiance, en minutes (0 = illimitée). Simple point
# de départ : « /2fa duree 2h » (ou « illimité ») la change à chaud et le réglage est
# persisté à côté des sessions ; cette valeur reprend la main s'il est perdu.
TWOFA_SESSION_MIN=15
# Plafond de ce que « /2fa duree » et la modale de déverrouillage acceptent.
# 0 = aucun plafond (l'illimité est permis).
TWOFA_SESSION_MAX_MIN=0
# Salon dédié aux commandes /2fa (créé/adopté par NOM)
TWOFA_CHANNEL_NAME=logs-2fa
# Rôle purement INDICATIF « 2FA Complet », attribué à tout inscrit
TWOFA_ROLE_ID=
# Magasin des secrets TOTP (0600). Par défaut <STATE_DIRECTORY>/2fa.json
TWOFA_PATH=
# Répertoire d'état (systemd StateDirectory). Par défaut /var/lib/discord-bot
STATE_DIRECTORY=/var/lib/discord-bot

# ===== Console LXC (termproxy) =====
TERMINAL_ENABLED=false
# Ouverture réservée à ces user-ids Discord (vide = repli sur ADMIN_IDS)
TERMINAL_OWNER_IDS=
# …ou à quiconque porte l'un de ces rôles
TERMINAL_OWNER_ROLE_IDS=
# Invités sensibles ré-exclus côté bot (double barrière avec l'ACL PVE)
TERMINAL_EXCLUDED_GUESTS=vaultwarden,mailserver,bdd
# Valeur PROPOSÉE par défaut dans la modale « inactivité » à l'ouverture d'un terminal
# (0 = illimitée). La modale accepte les minutes, les heures (2h, 1h30) et « illimité ».
TERMINAL_IDLE_MIN=10
# Plafond de la valeur saisie dans cette modale — 0 = AUCUN plafond, donc une console
# root peut être ouverte sans fermeture automatique. À ne lever qu'en connaissance de cause.
TERMINAL_IDLE_MAX_MIN=120
# Compte PVE dédié à la console (least-privilege, PAS root@pam)
PVE_CONSOLE_USER=botconsole@pve
PVE_CONSOLE_PASSWORD=
# Durée de vie ABSOLUE d'une console du nœud, même active (0 = illimité)
NODE_TERMINAL_MAX_MIN=120
# Invités exclus du bouton 💾 du salon nœud (200 = le PBS lui-même)
NODE_BACKUP_EXCLUDE=200

# ===== Cluster secondaire AVEYRON =====
# Vide (pas d'hôte ou pas de jeton) = bloc entièrement inactif, le R820 n'est pas impacté.
# ⚠️ Chaque nœud est un SERVEUR à part entière : sa clé « AVY-<NOM EN MAJUSCULES> » doit
# figurer dans GESTION_SERVERS (AVY-NAS, AVY-MS01, AVY-LLM…), sinon ses boutons sont refusés.
AVY_SERVER_KEY=AVEYRON
# Suffixe des invités distants (authentik -> authentik-avy)
AVY_SUFFIX=avy
# Points d'entrée ÉQUIVALENTS du cluster (Nico 2026-08-28) : le bot bascule seul sur le
# suivant si l'un ne répond plus. AVY_PVE_HOST (un seul hôte) reste accepté.
AVY_PVE_HOSTS=10.0.10.10,10.0.10.11,10.0.10.12
AVY_PVE_HOST=
# Utilisateur + mot de passe Proxmox (ticket renouvelé par proxmoxer) : s'ils sont
# renseignés, ils REMPLACENT les deux jetons ci-dessous pour la lecture ET les actions.
AVY_PVE_USER=
AVY_PVE_PASSWORD=
AVY_PVE_PORT=8006
AVY_PVE_VERIFY_SSL=false
AVY_PVE_TOKEN_ID=discordbot@pve!bot
AVY_PVE_TOKEN_SECRET=
AVY_PVE_ACTION_TOKEN_ID=discordbot@pve!actions
AVY_PVE_ACTION_TOKEN_SECRET=
AVY_PVE_STORAGE=nas-backup
# Nœuds supervisés, csv. STATIQUE volontairement : un nœud éteint garde ses salons.
AVY_NODES=
# Bucket InfluxDB DÉDIÉ Aveyron (jeton scopé à ce seul bucket)
AVY_INFLUX_BUCKET=Aveyron
AVY_INFLUX_TOKEN=

# ===== Salon temporaire de suivi du transfert média (2026-08-18) =====
# Salon PUBLIC en LECTURE SEULE, créé tant que l'unité systemd tourne sur l'hyperviseur
# et supprimé TRANSFERT_KEEP_MIN minutes après la fin. La sonde est une commande SSH de
# lecture seule sur le nœud (même clé que la console : NODE_SSH_*).
TRANSFERT_ENABLED=true
TRANSFERT_UNIT=media-backup.service
TRANSFERT_LOG=/var/log/media-backup.log
TRANSFERT_SOURCE=/mnt/media
TRANSFERT_DEST=/mnt/avy-media
TRANSFERT_CHANNEL_NAME=transfert-medias
TRANSFERT_POLL_SEC=60
TRANSFERT_KEEP_MIN=60

# ===== NAS Synology (lecture seule, via SNMP/Telegraf -> InfluxDB) =====
# Le bot n'a AUCUN accès au NAS : il ne fait que lire les mesures synology* d'Influx.
# Le bloc ne s'active que si SYNO_SERVER_KEY existe dans GESTION_SERVERS.
SYNO_SERVER_KEY=SYNO
SYNO_HOST=10.3.10.251

# ===== Jellyfin =====
JELLYFIN_URL=
JELLYFIN_API_KEY=
# Journal d'activité Jellyfin dans la catégorie 🔒 Lock (propriétaire uniquement)
JELLYFIN_LOGS_ENABLED=true
# Journal Dolibarr (CT108) dans #doli-logs (catégorie Lock, propriétaire seul), lu dans
# Loki {job="dolibarr"} (Alloy CT108). Incidents (PHP Fatal, cron KO, HTTP 5xx) -> #alertes.
DOLIBARR_LOGS_ENABLED=true
DOLIBARR_LOGS_POLL_SECONDS=30

# ===== Serveur de distribution Fronote (CT122 fronote-dist) =====
# API d'admin de la whitelist d'IP (dist.nicov1.fr, en direct LAN CT122:80).
# DIST_ADMIN_TOKEN = admin_token de /opt/fronote/dist/config.php sur CT122.
# Les deux vides = /dist et la veille des refus inactifs.
DIST_URL=
DIST_ADMIN_TOKEN=
# Salon des notifications « IP refusée » (vide = ALERT_CHANNEL_ID)
DIST_ALERT_CHANNEL_ID=
DIST_POLL_SECONDS=120

# ===== DNS maison AdGuard Home (CT125 dns, 10.3.10.53) =====
# API AdGuard Home (basic auth = compte de l'UI). USER/PASS vides = cog /dns inactif.
ADGUARD_URL=http://10.3.10.53:3000
ADGUARD_USER=
ADGUARD_PASS=
# Salon #dns : normalement provisionné (SUPER_CHANNELS « dns ») ; id de repli sinon
DNS_CHANNEL_ID=
# Sondage du journal des requêtes (secondes, minimum 15)
DNS_POLL_SECONDS=60
# DNS_FEED_LOGS=1 recopie TOUT le trafic DNS dans #journaux-live : Nico l a refuse le 28/08 (spam, on perd le but du salon). Laisser a 0.
DNS_FEED_LOGS=0
# DNS_BLOCKED_FEED=1 poste les requetes bloquees de chaque cycle dans #dns. Nico 28/08 :
# #dns = bilan horaire seulement (+ pics dans #alertes). Laisser a 0.
DNS_BLOCKED_FEED=0
# Seuils d'alerte par cycle de sondage : bloquées pour UN client / requêtes au total
DNS_SPIKE_BLOCKED=30
DNS_SPIKE_QUERIES=600

# ===== Divers =====
# HEARTBEAT_URL : dead-man's switch (healthchecks.io / ntfy). VIDE = AUCUNE surveillance
# externe : si le bot meurt la nuit, rien ne prévient. À renseigner.
HEARTBEAT_URL=
# DOCKER_CTL_ENABLED : kill-switch de /docker (pilotage des conteneurs de CT120)
DOCKER_CTL_ENABLED=true

# --- Relais des alertes Grafana PAR LE BOT (cog grafana_alerts, 29/08/2026) ---
# Nico : « pas de webhook grafana ». Grafana n a plus aucun contact point Discord ; le bot
# lit les alertes actives (API alertmanager, lecture seule) et poste 🔴 / ✅ Résolu.
# GRAFANA_TOKEN = token d un compte de service Grafana role Viewer (jamais admin).
GRAFANA_URL=http://10.3.10.104:3000
GRAFANA_TOKEN=
# Salon cible ; vide = ALERT_CHANNEL_ID.
GRAFANA_ALERT_CHANNEL_ID=
GRAFANA_POLL_SECONDS=60

# ===== VPN WireGuard (#vpn Supervision + #logs-vpn Archive) — R820 prioritaire, MikroTik CRS305 en secours =====
# Le bot lit `VPN_STATUS_CMD` sur l'hyperviseur (clé SSH restreinte du bot, root@10.3.10.200).
# C'est CE script qui interroge le MikroTik avec /root/.mt_pw : le mot de passe ne quitte jamais
# l'hyperviseur, CT106 n'a pas (et ne doit pas avoir) d'accès à 10.3.0.1. Source : tools/vpn-status.
VPN_ENABLED=true
VPN_CHANNEL_ID=                   # repli si l'id persisté (state vpn_msg) ne répond plus
VPN_POLL_SECONDS=60               # min 30 ; un relevé = ~5 s (ping 3 échos par pair + SSH MikroTik)
VPN_STATUS_CMD=/usr/local/sbin/vpn-status
VPN_EVENTS=true                   # lignes d'événement dans #logs-vpn (Archive, privé) (connexion, fin de session, bascule…)

# ---------------------------------------------------------------------------
# Fonctionnalités « serveur Discord » (2026-08-30) — journal d'événements, sondages,
# rappels, instantanés, FAQ, modération légère. Idées reprises du projet Ultra Suite,
# réécrites pour Edmine (état JSON local, permissions G/M/O, 2FA).
# ---------------------------------------------------------------------------
# Intents PRIVILÉGIÉS : cocher « Server Members Intent » (et « Message Content Intent »)
# dans https://discord.com/developers/applications AVANT de passer à true, sinon le bot
# refuse de démarrer. Sans `members` : arrivées/départs/rôles non journalisés, pas de
# rôle de bienvenue. Sans `message_content` : contenu des messages « indisponible ».
DISCORD_INTENT_MEMBERS=false
DISCORD_INTENT_MESSAGE_CONTENT=false
# Journal Discord (#discord-logs, créé dans 🔒 Lock ; 0 = création auto)
DISCORD_LOGS_ENABLED=true
DISCORD_LOGS_CHANNEL_ID=0
DISCORD_LOGS_VOICE=true
DISCORD_LOGS_ALERT_COOLDOWN=300
# Rôle donné automatiquement à tout humain qui arrive (0 = désactivé ; exige `members`)
WELCOME_ROLE_ID=0
# Instantanés quotidiens (04:00) de rôles/salons/overwrites, #alertes si des permissions bougent
SNAPSHOT_AUTO=true
SNAPSHOT_KEEP=30
# Sondages / rappels / FAQ / notes de modération
SONDAGE_DUREE_MAX_JOURS=30
SONDAGE_MAX_OUVERTS=20
RAPPEL_PURGE_JOURS=7
RAPPEL_MAX_PAR_UTILISATEUR=25
FAQ_MAX_LEN=1800
NOTE_MAX_LEN=500
